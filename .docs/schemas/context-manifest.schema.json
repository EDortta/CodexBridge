{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EDortta/AI-Agents/context-manifest.schema.json",
  "title": "AI-Agents context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "base", "tasks", "budgets", "retrieval", "telemetry"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "version": {"const": 1},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}}
    },
    "project": {"$ref": "#/$defs/sourceGroup"},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sourceGroup"}
    },
    "risks": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sourceGroup"}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_input_tokens", "categories"],
      "properties": {
        "total_input_tokens": {"type": "integer", "minimum": 1},
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_contracts", "task_contracts", "risk_contracts", "project_context", "active_work", "retrieved_evidence", "reserve"],
          "properties": {
            "base_contracts": {"type": "integer", "minimum": 0},
            "task_contracts": {"type": "integer", "minimum": 0},
            "risk_contracts": {"type": "integer", "minimum": 0},
            "project_context": {"type": "integer", "minimum": 0},
            "active_work": {"type": "integer", "minimum": 0},
            "retrieved_evidence": {"type": "integer", "minimum": 0},
            "reserve": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_sections", "max_section_tokens"],
      "properties": {
        "max_sections": {"type": "integer", "minimum": 1},
        "max_section_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "exclude_by_default": {"type": "array", "items": {"type": "string"}},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "retention_days", "content_capture"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "retention_days": {"type": "integer", "minimum": 1},
        "content_capture": {"const": false}
      }
    }
  },
  "$defs": {
    "sourceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {"include": {"type": "array", "items": {"$ref": "#/$defs/source"}}}
    },
    "source": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "mode": {"enum": ["full", "sections", "retrieve"]},
            "required": {"type": "boolean"},
            "category": {"enum": ["base_contracts", "task_contracts", "risk_contracts", "project_context", "active_work", "retrieved_evidence"]},
            "sections": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "terms": {"type": "array", "items": {"type": "string"}}
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "sections"}}},
              "then": {"required": ["sections"]}
            }
          ]
        }
      ]
    }
  }
}
