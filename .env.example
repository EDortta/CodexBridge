CODEX_BRIDGE_APP_NAME=codex-bridge-gateway
CODEX_BRIDGE_ENVIRONMENT=production
CODEX_BRIDGE_BIND_HOST=0.0.0.0
CODEX_BRIDGE_BIND_PORT=8080
CODEX_BRIDGE_DATABASE_URL=postgresql+psycopg://codexbridge:change-me@127.0.0.1:5432/codexbridge
# Signs mobile-API pagination cursors. Leave unset for a single-process
# gateway: cursors are then signed with a per-process random secret and stop
# working across a restart, which fails safe. Set it (to a long random value)
# when running more than one gateway process behind the same hostname.
# CODEX_BRIDGE_API_CURSOR_SECRET=
# Entries appended to X-Forwarded-For AFTER the one naming the client.
#
# Do NOT count proxies: the first proxy in a chain records the client rather than
# adding a hop beyond it, and which vhosts are in the path depends on what is
# installed. Measure it instead — send one request through the real front door
# and read the header this process receives:
#
#     hops = (number of entries in the received X-Forwarded-For) - 1
#
# Leave it unset until you have measured. Unset is safe-but-degraded: every
# anonymous caller shares one rate-limit bucket and a warning is logged. A wrong
# value is worse than none — too low lets a caller pick its own bucket, too high
# collapses everyone into one.
# CODEX_BRIDGE_API_TRUSTED_PROXY_HOPS=
# Whether GET /ready reports executor connectivity. Off by default: the endpoint
# is unauthenticated, and the boolean is a presence signal about the operator's
# machines — pollable from outside to chart when they are online.
# CODEX_BRIDGE_READY_EXPOSE_EXECUTOR_STATE=false
# How long a readiness result is reused, in seconds. /ready is unauthenticated
# and not rate-limited; without caching, each anonymous request took a connection
# from the pool that serves the API.
# CODEX_BRIDGE_READY_CACHE_SECONDS=5
# Build or commit identifier reported by GET /api/version. Unauthenticated —
# publish a short sha, not a branch name or an internal ticket reference.
# CODEX_BRIDGE_BUILD_REVISION=
CODEX_BRIDGE_REGISTRY_FILE=/etc/codex-bridge/registry.json
CODEX_BRIDGE_USER_REGISTRY_FILE=/etc/codex-bridge/users.json
CODEX_BRIDGE_PUBLIC_BASE_URL=https://codexbridge.inovacaosistemas.com.br:8443
CODEX_BRIDGE_MCP_AUTH_MODE=oauth
CODEX_BRIDGE_MCP_BEARER_TOKEN=replace-with-strong-random-token
CODEX_BRIDGE_OAUTH_ALLOWED_CLIENT_IDS=chatgpt-codexbridge
CODEX_BRIDGE_OAUTH_ALLOWED_REDIRECT_URI_PREFIXES=https://chatgpt.com,https://chat.openai.com,https://auth.openai.com
CODEX_BRIDGE_OAUTH_DEFAULT_SCOPES=codexbridge.read codexbridge.task.submit codexbridge.task.cancel
CODEX_BRIDGE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
CODEX_BRIDGE_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=600
CODEX_BRIDGE_MAX_LOG_CHUNK_CHARS=4000
CODEX_BRIDGE_MAX_RESULT_CHARS=200000
CODEX_BRIDGE_DIFF_MAX_CHARS=120000

CODEX_BRIDGE_AGENT_GATEWAY_WS_URL=wss://codexbridge.inovacaosistemas.com.br:8443/agent/ws
CODEX_BRIDGE_AGENT_EXECUTOR_ID=T610
CODEX_BRIDGE_AGENT_MACHINE_TOKEN=replace-with-strong-random-token
CODEX_BRIDGE_AGENT_ALLOWED_PROJECTS_FILE=/etc/codex-bridge-agent/projects.json
CODEX_BRIDGE_AGENT_CODEX_BIN=/usr/local/bin/codex
CODEX_BRIDGE_AGENT_HEARTBEAT_INTERVAL_SECONDS=15
CODEX_BRIDGE_AGENT_RECONNECT_MIN_SECONDS=2
CODEX_BRIDGE_AGENT_RECONNECT_MAX_SECONDS=30
CODEX_BRIDGE_AGENT_MAX_CONCURRENT_TASKS=1
