{
  "_comment": "Template for .credentials/google-calendar-sa.json -- a symlink to a real Google service-account key file, never committed. The private_key value below is a placeholder, never a real key.",
  "type": "service_account",
  "project_id": "replace-with-real-project-id",
  "private_key_id": "replace-with-real-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n",
  "client_email": "replace@replace.iam.gserviceaccount.com",
  "client_id": "replace-with-real-client-id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "replace-with-real-cert-url"
}
