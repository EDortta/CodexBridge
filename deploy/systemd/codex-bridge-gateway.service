[Unit]
Description=Codex Bridge Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexbridge
Group=codexbridge
WorkingDirectory=/opt/codex-bridge
EnvironmentFile=/etc/codex-bridge/env
ExecStart=/opt/codex-bridge/.venv/bin/uvicorn gateway.app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codex-bridge
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
