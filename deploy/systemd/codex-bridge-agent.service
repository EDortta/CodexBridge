[Unit]
Description=Codex Bridge Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexbridge
Group=codexbridge
WorkingDirectory=/opt/codex-bridge
EnvironmentFile=/etc/codex-bridge-agent/env
ExecStart=/opt/codex-bridge/.venv/bin/python -m agent.codex_bridge_agent.service
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# WK-20260830-chatgpt-entry-provider-and-delivery, issue #41a: Claude Code
# needs its own config dir writable, the same way Codex needs ~/.codex. This
# is a real relaxation of ProtectHome=read-only's blast radius, not a no-op --
# call it out on review, don't let it slide in as a side effect of a feature PR.
ReadWritePaths=/srv/projects /var/lib/codex-bridge-agent /home/codexbridge/.codex /home/codexbridge/.claude
MemoryMax=2G
TasksMax=256
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
