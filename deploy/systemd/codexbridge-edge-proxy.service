[Unit]
Description=CodexBridge Edge Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexbridge
Group=codexbridge
WorkingDirectory=/opt/codex-bridge
Environment=CODEXBRIDGE_EDGE_UPSTREAM=https://codexbridge.inovacaosistemas.com.br:8443
Environment=CODEXBRIDGE_EDGE_HOST=codexbridge.inovacaosistemas.com.br
ExecStart=/opt/codex-bridge/.venv/bin/uvicorn deploy.incus.codexbridge_edge_proxy:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
